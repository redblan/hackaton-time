{
  "name": "hackaton-time",
  "private": true,
  "type": "module",
  "workspaces": [
    "shared",
    "ai",
    "world",
    "server",
    "client"
  ],
  "scripts": {
    "dev": "node scripts/dev.mjs",
    "build": "npm run build -w client",
    "start": "npm run build && npm run start -w server",
    "db": "docker compose up -d db",
    "typecheck": "npm run typecheck --workspaces --if-present",
    "test": "npm run test --workspaces --if-present",
    "check": "npm run typecheck && npm run test",
    "world": "npm run build -w world",
    "chat": "npm run chat -w ai --",
    "walk": "tsx scripts/walk-check.ts",
    "e2e": "node scripts/e2e-solo.mjs"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "tsx": "^4.19.0",
    "typescript": "^5.6.0",
    "vitest": "^3.0.0"
  },
  "engines": {
    "node": ">=20.9"
  }
}
