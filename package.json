{
  "name": "hackaton-time",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "gen": "tsx scripts/gen-registry.ts",
    "dev": "npm run gen && next dev",
    "build": "npm run gen && next build",
    "start": "next start",
    "lint": "eslint",
    "typecheck": "npm run gen && next typegen && tsc --noEmit",
    "check": "npm run typecheck && npm run lint",
    "format": "prettier --write .",
    "db:push": "drizzle-kit push",
    "db:studio": "drizzle-kit studio",
    "db:seed": "tsx scripts/seed.ts",
    "demo": "drizzle-kit push --force && tsx scripts/seed.ts",
    "new:feature": "tsx scripts/new-feature.ts"
  },
  "dependencies": {
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "drizzle-orm": "^0.45.4",
    "geist": "^1.9.0",
    "leaflet": "^1.9.4",
    "lucide-react": "^1.65.0",
    "next": "16.4.3",
    "postgres": "^4.0.0",
    "radix-ui": "^1.8.1",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "react-leaflet": "^5.0.0",
    "recharts": "^3.10.1",
    "server-only": "^0.0.1",
    "sonner": "^2.0.8",
    "tailwind-merge": "^3.7.0",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@faker-js/faker": "^10.6.0",
    "@tailwindcss/turbopack": "^4",
    "@types/leaflet": "^1.9.22",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "dotenv": "^18.0.9",
    "drizzle-kit": "^0.31.11",
    "eslint": "^9",
    "eslint-config-next": "16.4.3",
    "prettier": "^3.9.10",
    "tailwindcss": "^4",
    "tsx": "^4.23.15",
    "tw-animate-css": "^1.4.0",
    "typescript": "^5"
  },
  "engines": {
    "node": ">=20.9"
  }
}
