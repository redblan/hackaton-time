# Postgres. Создайте базу: createdb hackaton
# (или поднимите через docker compose up -d — тогда строка та же)
DATABASE_URL=postgres://postgres:postgres@localhost:5432/hackaton

# --- ИИ-ассистент (любой OpenAI-совместимый API) ---
# Пусто или DEMO_MODE=1 -> ассистент отвечает заготовками без сети.
# Примеры:
#   OpenRouter:  LLM_BASE_URL=https://openrouter.ai/api/v1
#   YandexGPT:   LLM_BASE_URL=https://llm.api.cloud.yandex.net/v1  (модель вида gpt://<folder>/yandexgpt/latest)
#   Ollama:      LLM_BASE_URL=http://localhost:11434/v1  LLM_API_KEY=ollama
LLM_BASE_URL=
LLM_API_KEY=
LLM_MODEL=
DEMO_MODE=1
